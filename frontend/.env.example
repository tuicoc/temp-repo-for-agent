# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_,
# and it inlines them into the built bundle — so anything here is public.
# Never put a secret in this file or in .env.

# Where the backend is. Leave blank in development: vite.config.js proxies
# /api to the local backend, which keeps the dev setup free of CORS.
# In production this is NOT read from here. Vite inlines VITE_* variables at
# build time, and the deployed build runs in GitHub Actions, so the value lives
# in .github/workflows/azure-static-web-apps-*.yml instead.
VITE_API_BASE_URL=
