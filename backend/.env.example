# Copy to .env and fill in. .env is git-ignored; this file is not, so no value
# here is ever a real one.
#
# This file describes a local run. What a deployment needs is in the README —
# it is not the same list, and the values are not these.

# ── Model providers ──────────────────────────────────────────────────────────
# The names each LangChain integration reads by default, so a key is never
# passed in code. Only the provider the advisor is routed to in
# config/models.yaml is needed to run; the rest are for the probe.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=

# The PolicyAgent's evaluation model (Jev), through Vercel AI Gateway. Without
# it the soft policy check is skipped and the hard check alone guards replies.
# The gateway refuses calls until the Vercel team has a card on file.
# https://vercel.com/docs/ai-gateway/authentication-and-byok
AI_GATEWAY_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# The Postgres docker compose starts. Port 55432, not 5432, so it cannot
# collide with one already installed on the machine.
#
#   cd backend
#   docker compose up -d
#   uvicorn src.api.app:app --reload
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/agentcore

# ── Web service ──────────────────────────────────────────────────────────────
# Signs access tokens. At least 32 bytes or the app refuses to start: HS256
# with a short key is guessable. Generate one, never invent one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The only account that can sign in; there is no registration page. Left blank
# on purpose. A default password printed in a committed file is how default
# passwords reach production.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Optional second account with the customer role, for testing the chat as a
# customer while the console is open under the staff account.
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# Where the browser app runs, comma separated, no trailing slash. No wildcard:
# these requests carry an Authorization header and browsers reject "*" then.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── The organisers' data ─────────────────────────────────────────────────────
# Catalogue, CRM seed, promotions, policy documents and the reference mock
# tools. They ship in data/btc; leave blank unless a newer pack sits elsewhere.
BTC_DATA_DIR=

# ── Voice ────────────────────────────────────────────────────────────────────
# Where the model weights go; the API fetches the missing ones when it starts.
# Leave blank for backend/models/voice. On Azure it must be under /home, the
# only folder that survives a restart.
VOICE_MODELS_DIR=

# ── Tracing (optional) ───────────────────────────────────────────────────────
# Leave blank to run without it; nothing else changes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
