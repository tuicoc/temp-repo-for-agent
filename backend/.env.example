# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real key here.

# ── Models ───────────────────────────────────────────────────────────────────
# These names are the ones each LangChain integration reads by default, so the
# key never has to be passed in code. Only the provider the advisor is routed
# to in config/models.yaml is required; the others are for the probe.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com  (account menu -> API keys)
NVIDIA_API_KEY=

# ── Web service ──────────────────────────────────────────────────────────────
# Signing key for access tokens. Generate one, do not invent one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The single account that can sign in. There is no registration page.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Azure Database for PostgreSQL requires TLS, so sslmode=require is not
# optional: without it the connection is refused.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Exact origins the browser app is served from, comma separated. No wildcard:
# these requests carry an Authorization header and browsers reject "*" then.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Tracing (optional) ───────────────────────────────────────────────────────
# Leave blank to run without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
