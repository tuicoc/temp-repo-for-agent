# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real key here.
#
# These names are the ones each LangChain integration reads by default, so the
# key never has to be passed in code.

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://build.nvidia.com  (account menu -> API keys)
NVIDIA_API_KEY=

# Tracing (optional). Leave blank to run without it.
# https://cloud.langfuse.com  -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud region, or your own host. EU: https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
